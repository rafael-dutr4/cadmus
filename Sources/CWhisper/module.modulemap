// whisper.cpp comes from Homebrew (`brew install whisper-cpp`), which is why
// the path is absolute. The library is not vendored: it is a C++ project with
// its own build system and its own accelerated backends, and tracking it by
// hand would be work that buys nothing.
module CWhisper [system] {
    header "/opt/homebrew/include/whisper.h"
    link "whisper"
    export *
}
