<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Kadmos</string>
	<key>CFBundleIdentifier</key>
	<string>br.dutra.kadmos</string>
	<key>CFBundleExecutable</key>
	<string>Kadmos</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<!-- macOS refuses the microphone to a process that does not say why it
	     wants it, so this string is required and not decoration. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Kadmos records what you dictate and turns it into text on this machine.</string>
	<!-- No dock icon, no window. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
</dict>
</plist>
